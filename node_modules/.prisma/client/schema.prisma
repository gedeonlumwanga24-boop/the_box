generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MANAGER
  ADMIN
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum MessageStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ErrorLogStatus {
  EN_ATTENTE
  RESOLU
}

enum ErrorLogSeverity {
  ERROR
  WARNING
  INFO
  DEBUG
  CRITICAL
}

model User {
  id              BigInt    @id @default(autoincrement())
  name            String    @db.VarChar(160)
  email           String    @unique @db.VarChar(320)
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  googleId        String?   @unique @map("google_id") @db.VarChar(255)
  avatarUrl       String?   @map("avatar_url") @db.Text
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  role            UserRole  @default(CUSTOMER)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile        Client?
  carts          Cart[]
  orders         Order[]
  messages       Message[]
  errorLogs      ErrorLog[] @relation("ErrorLogUser")
  resolvedErrors ErrorLog[] @relation("ErrorLogResolver")
  sessions       Session[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model Client {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @unique @map("user_id")
  phone     String?  @db.VarChar(32)
  address   String?  @db.Text
  city      String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("clients")
}

model Category {
  id           BigInt   @id @default(autoincrement())
  parentId     BigInt?  @map("parent_id")
  name         String   @db.VarChar(160)
  slug         String   @unique @db.VarChar(180)
  imageUrl     String?  @map("image_url") @db.Text
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId, displayOrder])
  @@index([isActive, displayOrder])
  @@map("categories")
}

model Product {
  id          BigInt   @id @default(autoincrement())
  categoryId  BigInt   @map("category_id")
  name        String   @db.VarChar(200)
  slug        String   @unique @db.VarChar(220)
  description String?  @db.Text
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("CDF") @db.Char(3)
  stock       Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category   Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([categoryId, isActive])
  @@index([isActive, createdAt])
  @@map("products")
}

model ProductImage {
  id        BigInt   @id @default(autoincrement())
  productId BigInt   @map("product_id")
  url       String   @db.Text
  altText   String?  @map("alt_text") @db.VarChar(240)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
  @@map("product_images")
}

model Cart {
  id        BigInt     @id @default(autoincrement())
  userId    BigInt?    @map("user_id")
  sessionId String?    @map("session_id") @db.VarChar(128)
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId, status])
  @@index([sessionId, status])
  @@map("carts")
}

model CartItem {
  id        BigInt   @id @default(autoincrement())
  cartId    BigInt   @map("cart_id")
  productId BigInt   @map("product_id")
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  currency  String   @default("CDF") @db.Char(3)
  size      String?  @db.VarChar(64)
  color     String?  @db.VarChar(64)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id              BigInt      @id @default(autoincrement())
  userId          BigInt      @map("user_id")
  total           Decimal     @db.Decimal(12, 2)
  currency        String      @default("CDF") @db.Char(3)
  status          OrderStatus @default(PENDING)
  shippingAddress String      @map("shipping_address") @db.Text
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id          BigInt   @id @default(autoincrement())
  orderId     BigInt   @map("order_id")
  productId   BigInt?  @map("product_id")
  productName String   @map("product_name") @db.VarChar(200)
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  currency    String   @default("CDF") @db.Char(3)
  options     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                BigInt        @id @default(autoincrement())
  orderId           BigInt        @map("order_id")
  provider          String        @db.VarChar(50)
  providerReference String?       @map("provider_reference") @db.VarChar(128)
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(128)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("CDF") @db.Char(3)
  status            PaymentStatus @default(PENDING)
  metadata          Json?
  confirmedAt       DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerReference])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("payments")
}

model Role {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  guardName String   @default("web") @map("guard_name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  modelRoles  ModelHasRole[]

  @@map("roles")
}

model Permission {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique @db.VarChar(255)
  guardName String   @default("web") @map("guard_name") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions  RolePermission[]
  modelPermissions ModelHasPermission[]

  @@map("permissions")
}

model RolePermission {
  permissionId BigInt @map("permission_id")
  roleId       BigInt @map("role_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([permissionId, roleId])
  @@map("role_has_permissions")
}

model ModelHasRole {
  roleId    BigInt @map("role_id")
  modelType String @map("model_type") @db.VarChar(255)
  modelId   BigInt @map("model_id")

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, modelId, modelType])
  @@map("model_has_roles")
}

model ModelHasPermission {
  permissionId BigInt @map("permission_id")
  modelType    String @map("model_type") @db.VarChar(255)
  modelId      BigInt @map("model_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([permissionId, modelId, modelType])
  @@map("model_has_permissions")
}

model Message {
  id             BigInt        @id @default(autoincrement())
  userId         BigInt?       @map("user_id")
  name           String        @db.VarChar(255)
  email          String        @db.VarChar(320)
  subject        String?       @db.VarChar(255)
  message        String        @db.Text
  status         MessageStatus @default(PENDING)
  isAdmin        Boolean       @default(false) @map("is_admin")
  adminNotes     String?       @map("admin_notes") @db.Text
  adminResponse  String?       @map("admin_response") @db.Text
  reply          String?       @db.Text
  readAt         DateTime?     @map("read_at") @db.Timestamptz(6)
  respondedAt    DateTime?     @map("responded_at") @db.Timestamptz(6)
  responseReadAt DateTime?     @map("response_read_at") @db.Timestamptz(6)
  clientRead     Boolean       @default(false) @map("client_read")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt      DateTime?     @map("deleted_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([isAdmin])
  @@index([createdAt(sort: Desc)])
  @@index([email])
  @@map("messages")
}

model SiteConfig {
  id          BigInt   @id @default(autoincrement())
  key         String   @unique @db.VarChar(255)
  value       String?  @db.Text
  description String?  @db.Text
  type        String   @default("string") @db.VarChar(50)
  isPublic    Boolean  @default(false) @map("is_public")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([key])
  @@index([isPublic])
  @@map("site_configs")
}

model ErrorLog {
  id          BigInt           @id @default(autoincrement())
  message     String           @db.Text
  stackTrace  String?          @map("stack_trace") @db.Text
  url         String?          @db.VarChar(500)
  method      String?          @db.VarChar(10)
  ipAddress   String?          @map("ip_address") @db.VarChar(45)
  userId      BigInt?          @map("user_id")
  status      ErrorLogStatus   @default(EN_ATTENTE)
  severity    ErrorLogSeverity @default(ERROR)
  environment String           @default("production") @db.VarChar(50)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt  DateTime?        @map("resolved_at") @db.Timestamptz(6)
  resolvedBy  BigInt?          @map("resolved_by")

  user     User? @relation("ErrorLogUser", fields: [userId], references: [id], onDelete: SetNull)
  resolver User? @relation("ErrorLogResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([severity])
  @@index([environment])
  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@map("error_logs")
}

model Notification {
  id             String    @id @default(uuid()) @db.Uuid
  type           String    @db.VarChar(255)
  notifiableType String    @map("notifiable_type") @db.VarChar(255)
  notifiableId   BigInt    @map("notifiable_id")
  data           Json
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([notifiableType, notifiableId])
  @@index([readAt])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model Session {
  id           String  @id @db.VarChar(255)
  userId       BigInt? @map("user_id")
  ipAddress    String? @map("ip_address") @db.VarChar(45)
  userAgent    String? @map("user_agent") @db.Text
  payload      String  @db.Text
  lastActivity Int     @map("last_activity")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([lastActivity])
  @@map("sessions")
}

model Cache {
  key        String @id @db.VarChar(255)
  value      String @db.Text
  expiration Int

  @@map("cache")
}

model CacheLock {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int

  @@map("cache_locks")
}

model Job {
  id          BigInt @id @default(autoincrement())
  queue       String @db.VarChar(255)
  payload     String @db.Text
  attempts    Int    @default(0)
  reservedAt  Int?   @map("reserved_at")
  availableAt Int    @map("available_at")
  createdAt   Int    @map("created_at")

  @@index([queue])
  @@map("jobs")
}

model FailedJob {
  id         String   @id @default(uuid()) @db.Uuid
  uuid       String   @unique @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.Text
  exception  String   @db.Text
  failedAt   DateTime @default(now()) @map("failed_at") @db.Timestamptz(6)

  @@map("failed_jobs")
}

model JobBatch {
  id           String  @id @db.VarChar(255)
  name         String  @db.VarChar(255)
  totalJobs    Int     @map("total_jobs")
  pendingJobs  Int     @map("pending_jobs")
  failedJobs   Int     @map("failed_jobs")
  failedJobIds String  @map("failed_job_ids") @db.Text
  options      String? @db.Text
  cancelledAt  Int?    @map("cancelled_at")
  createdAt    Int     @map("created_at")
  finishedAt   Int?    @map("finished_at")

  @@map("job_batches")
}

model PasswordResetToken {
  email     String   @id @db.VarChar(320)
  token     String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([token])
  @@map("password_reset_tokens")
}

model PersonalAccessToken {
  id            BigInt    @id @default(autoincrement())
  tokenableType String    @map("tokenable_type") @db.VarChar(255)
  tokenableId   BigInt    @map("tokenable_id")
  name          String    @db.VarChar(255)
  token         String    @unique @db.VarChar(64)
  abilities     String?   @db.Text
  lastUsedAt    DateTime? @map("last_used_at") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tokenableType, tokenableId])
  @@map("personal_access_tokens")
}
